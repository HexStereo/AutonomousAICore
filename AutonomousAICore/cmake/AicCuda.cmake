# CUDA detection. Sets AIC_WITH_CUDA / AIC_WITH_CUBLAS.
set(AIC_WITH_CUDA OFF)
set(AIC_WITH_CUBLAS OFF)

if(AIC_ENABLE_CUDA)
    if(AIC_CUDA_ALLOW_UNSUPPORTED_COMPILER)
        set(CMAKE_CUDA_FLAGS "${CMAKE_CUDA_FLAGS} -allow-unsupported-compiler" CACHE STRING "" FORCE)
    endif()
    if(NOT CMAKE_CUDA_COMPILER)
        include(CheckLanguage)
        check_language(CUDA)
    endif()
    if(CMAKE_CUDA_COMPILER)
        # Blackwell consumer GPUs (RTX 50xx) are sm_120. Override with -DCMAKE_CUDA_ARCHITECTURES=native/89/90...
        if(NOT DEFINED CMAKE_CUDA_ARCHITECTURES OR CMAKE_CUDA_ARCHITECTURES STREQUAL "")
            set(CMAKE_CUDA_ARCHITECTURES 120)
        endif()
        enable_language(CUDA)
        set(CMAKE_CUDA_STANDARD 20)
        set(CMAKE_CUDA_STANDARD_REQUIRED ON)
        set(CMAKE_CUDA_RUNTIME_LIBRARY Static)
        find_package(CUDAToolkit REQUIRED)
        set(AIC_WITH_CUDA ON)
        message(STATUS "CUDA compiler: ${CMAKE_CUDA_COMPILER} (${CMAKE_CUDA_COMPILER_VERSION})")
        message(STATUS "CUDA toolkit : ${CUDAToolkit_VERSION}")
        if(AIC_ENABLE_CUBLAS)
            if(TARGET CUDA::cublas)
                set(AIC_WITH_CUBLAS ON)
            else()
                message(WARNING "AIC_ENABLE_CUBLAS=ON but CUDA::cublas was not found; disabling")
            endif()
        endif()
    else()
        message(WARNING "No CUDA compiler found - building the CPU-only backend. "
                        "Install the CUDA Toolkit or set CMAKE_CUDA_COMPILER to enable GPU support.")
    endif()
endif()
